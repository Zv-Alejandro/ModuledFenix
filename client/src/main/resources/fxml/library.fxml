<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            prefWidth="1300.0"
            prefHeight="800.0"
            minWidth="0.0"
            minHeight="0.0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="library-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ies.fenix.client.controller.LibraryController">

    <center>
        <HBox spacing="0.0"
              maxWidth="Infinity"
              maxHeight="Infinity"
              styleClass="library-main-container">

            <!-- LEFT LIBRARY PANEL -->
            <VBox prefWidth="360.0"
                  minWidth="360.0"
                  maxWidth="360.0"
                  maxHeight="Infinity"
                  styleClass="library-left-panel">

                <padding>
                    <Insets top="20.0" right="15.0" bottom="20.0" left="20.0"/>
                </padding>

                <!-- SEARCH AREA -->
                <HBox alignment="CENTER_LEFT"
                      styleClass="library-search-wrapper">

                    <TextField fx:id="searchField"
                               promptText="Search"
                               HBox.hgrow="ALWAYS"
                               styleClass="library-search-field"/>

                    <Label text="≡"
                           styleClass="library-filter-icon"/>
                </HBox>

                <!-- OWNED GAMES LIST -->
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            maxHeight="Infinity"
                            styleClass="library-left-scroll">

                    <content>
                        <VBox fx:id="leftGamesList"
                              spacing="22.0"
                              maxWidth="Infinity"
                              styleClass="library-left-games-list">

                            <padding>
                                <Insets top="28.0" right="5.0" bottom="20.0" left="0.0"/>
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- RIGHT LIBRARY PANEL -->
            <ScrollPane fx:id="rightLibraryScroll"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity"
                        maxHeight="Infinity"
                        styleClass="library-right-scroll">

                <content>
                    <GridPane fx:id="libraryGrid"
                              hgap="18.0"
                              vgap="24.0"
                              maxWidth="Infinity"
                              styleClass="library-grid">

                        <padding>
                            <Insets top="70.0" right="28.0" bottom="30.0" left="28.0"/>
                        </padding>
                    </GridPane>
                </content>
            </ScrollPane>

        </HBox>
    </center>
</BorderPane>