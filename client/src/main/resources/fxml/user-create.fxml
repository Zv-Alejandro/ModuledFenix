<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane prefHeight="960.0"
           prefWidth="460.0"
           styleClass="auth-root"
           stylesheets="@../styles/styles.css"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.ies.fenix.client.controller.ClientController">

    <!-- Fondo decorativo -->
    <Circle radius="155.0"
            translateX="-185.0"
            translateY="-335.0"
            styleClass="auth-circle-primary"/>

    <Circle radius="115.0"
            translateX="205.0"
            translateY="-120.0"
            styleClass="auth-circle-secondary"/>

    <Circle radius="135.0"
            translateX="-205.0"
            translateY="350.0"
            styleClass="auth-circle-accent"/>

    <BorderPane fx:id="root"
                maxHeight="-Infinity"
                maxWidth="-Infinity"
                minHeight="-Infinity"
                minWidth="-Infinity"
                prefHeight="960.0"
                prefWidth="460.0"
                styleClass="auth-content">

        <top>
            <HBox alignment="TOP_RIGHT"
                  prefHeight="40.0"
                  prefWidth="454.0"
                  BorderPane.alignment="CENTER">
                <padding>
                    <Insets right="20.0" top="10.0"/>
                </padding>

                <Button mnemonicParsing="false"
                        prefHeight="34.0"
                        prefWidth="34.0"
                        textAlignment="RIGHT"
                        styleClass="auth-settings-button">
                    <graphic>
                        <ImageView fx:id="settingsImage"
                                   fitHeight="18.0"
                                   fitWidth="15.0"
                                   pickOnBounds="true"
                                   preserveRatio="true"/>
                    </graphic>
                </Button>
            </HBox>
        </top>

        <center>
            <VBox alignment="CENTER"
                  prefHeight="200.0"
                  prefWidth="100.0"
                  spacing="20.0"
                  BorderPane.alignment="CENTER">

                <ImageView fx:id="logoImage"
                           fitHeight="130.0"
                           fitWidth="250.0"
                           pickOnBounds="true"
                           preserveRatio="true"/>

                <Text strokeType="OUTSIDE"
                      strokeWidth="0.0"
                      text="Por último"
                      styleClass="auth-title">
                    <font>
                        <Font name="System Bold" size="48.0"/>
                    </font>
                </Text>

                <Text strokeType="OUTSIDE"
                      strokeWidth="0.0"
                      text="Escribe tu nombre de usuario y contraseña"
                      styleClass="auth-subtitle">
                    <font>
                        <Font size="16.0"/>
                    </font>
                </Text>

                <TextField fx:id="username"
                           prefHeight="45.0"
                           prefWidth="434.0"
                           promptText="Usuario"
                           styleClass="auth-field">
                    <VBox.margin>
                        <Insets left="25.0" right="25.0"/>
                    </VBox.margin>
                    <font>
                        <Font size="20.0"/>
                    </font>
                </TextField>

                <PasswordField fx:id="password"
                               prefHeight="45.0"
                               prefWidth="434.0"
                               promptText="Contraseña"
                               styleClass="auth-field">
                    <VBox.margin>
                        <Insets left="25.0" right="25.0"/>
                    </VBox.margin>
                    <font>
                        <Font size="20.0"/>
                    </font>
                </PasswordField>

                <PasswordField fx:id="passwordCheck"
                               prefHeight="45.0"
                               prefWidth="434.0"
                               promptText="Misma contraseña"
                               styleClass="auth-field">
                    <VBox.margin>
                        <Insets left="25.0" right="25.0"/>
                    </VBox.margin>
                    <font>
                        <Font size="20.0"/>
                    </font>
                </PasswordField>

                <Button mnemonicParsing="false"
                        prefHeight="45.0"
                        prefWidth="396.0"
                        text="Continuar"
                        onAction="#saveUserAndOpenLogInView"
                        styleClass="auth-main-button">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Button>

                <Label fx:id="clientErrorLabel"
                       prefHeight="45.0"
                       prefWidth="434.0"
                       text="Label"
                       wrapText="true"
                       alignment="CENTER"
                       textAlignment="CENTER"/>

                <Text strokeType="OUTSIDE"
                      strokeWidth="0.0"
                      text="Al continuar, aceptas nuestra Política de privacidad"
                      styleClass="auth-footer-text">
                    <font>
                        <Font size="16.0"/>
                    </font>
                </Text>
            </VBox>
        </center>
    </BorderPane>
</StackPane>