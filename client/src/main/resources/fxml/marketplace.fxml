<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            prefWidth="1300.0"
            prefHeight="800.0"
            minWidth="0.0"
            minHeight="0.0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="marketplace-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ies.fenix.client.controller.MarketplaceController">

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="true"
                    maxWidth="Infinity"
                    maxHeight="Infinity"
                    styleClass="main-scroll">

            <content>
                <VBox spacing="35.0"
                      fillWidth="true"
                      maxWidth="Infinity"
                      styleClass="content-container">

                    <padding>
                        <Insets top="45.0" right="30.0" bottom="45.0" left="30.0"/>
                    </padding>

                    <!-- LATEST RELEASED SECTION -->
                    <VBox spacing="18.0"
                          maxWidth="Infinity">

                        <HBox alignment="CENTER_LEFT"
                              maxWidth="Infinity">

                            <VBox spacing="5.0">
                                <Label text="Latest released"
                                       styleClass="section-title"/>

                                <Label text="New histories to play!"
                                       styleClass="section-subtitle"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <TextField fx:id="searchField"
                                       promptText="Search"
                                       prefWidth="420.0"
                                       maxWidth="420.0"
                                       styleClass="search-field"/>
                        </HBox>

                        <ScrollPane fitToHeight="true"
                                    fitToWidth="false"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    pannable="true"
                                    prefViewportHeight="285.0"
                                    maxWidth="Infinity"
                                    styleClass="horizontal-games-scroll">

                            <content>
                                <HBox fx:id="latestReleasedContainer"
                                      spacing="24.0"
                                      styleClass="games-row"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <!-- EXPLORE GAMES SECTION -->
                    <VBox spacing="18.0"
                          maxWidth="Infinity">

                        <VBox spacing="5.0">
                            <Label text="Explore games"
                                   styleClass="section-title"/>

                            <Label text="Discover more stories to play"
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <ScrollPane fitToWidth="true"
                                    fitToHeight="false"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="NEVER"
                                    pannable="false"
                                    prefViewportHeight="850.0"
                                    maxWidth="Infinity"
                                    styleClass="horizontal-games-scroll">

                            <content>
                                <GridPane fx:id="recommendationsContainer"
                                          hgap="24.0"
                                          vgap="24.0"
                                          maxWidth="Infinity"
                                          styleClass="games-row"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>